# LLM Provider: "ollama" (local) or "openai" (cloud)
LLM_PROVIDER=ollama

# Ollama Settings (only if LLM_PROVIDER=ollama)
# For Docker: use http://ollama:11434
# For local dev: use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# OpenAI Settings (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application
DEBUG=true

# CRM Storage
CRM_STORAGE_PATH=./data/crm_leads.json
